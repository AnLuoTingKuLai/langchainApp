# 可提交。凭证字段留空，其余与本机 .env.develop 相同。实际凭证只写在 .env.develop。

# createLlm 未传模型名时，用这个名字取映射表里的配置
VITE_DEFAULT_MODEL=ollama

# Ollama 本地（MODEL 带 :tag 即走本地）
VITE_OLLAMA_API_KEY=
VITE_OLLAMA_MODEL=deepseek-r1:8b
VITE_OLLAMA_BASE_URL=http://localhost:11434
# 浏览器直连该地址（无 Vite 代理）

# DeepSeek 云端
VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_MODEL=deepseek-flash

# Google Gemini（备用）
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3-flash-preview
