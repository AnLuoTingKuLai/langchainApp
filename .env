# createLlm 未传模型名时，用这个名字取映射表里的配置
VITE_DEFAULT_MODEL=ollama

# ---------- 以下为配置参考（复制到上方「当前生效」启用）----------

# Ollama 本地（MODEL 带 :tag 即走本地）
VITE_OLLAMA_API_KEY=ollama
VITE_OLLAMA_MODEL=deepseek-r1:8b
VITE_OLLAMA_BASE_URL=http://localhost:11434
# 浏览器直连该地址（无 Vite 代理）

# DeepSeek 云端
VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_MODEL=

# Google Gemini（备用）
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=
